# Copy these values into your deployment environment or IDE run configuration.
# Use long, unique random values; do not commit the real file.
#
# Generate the two 32-byte keys with:
#   openssl rand -base64 32

# ── Database ──────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/votingdb
DB_USERNAME=postgres
DB_PASSWORD=replace-with-database-password

# ── Machine and administrator security ───────────────────
# base64, exactly 32 bytes. Encrypts terminal signing keys at rest.
EVOTING_MASTER_KEY=replace-with-32-byte-base64-value
# base64, exactly 32 bytes. Signs machine JWTs.
EVOTING_JWT_SECRET=replace-with-32-byte-base64-value
# Any high-entropy string. Mixed into fingerprint templates — changing this
# later invalidates every existing enrollment.
EVOTING_FINGERPRINT_PEPPER=replace-with-a-long-random-string
# Provisions terminals still PENDING on startup. Leave unset to provision
# each terminal by hand from the admin dashboard instead.
EVOTING_MACHINE_BOOTSTRAP_SECRET=replace-with-a-long-random-string
# Second factor required for privileged terminal actions (opening/closing
# polling, reading results) — not the dashboard login itself.
EVOTING_ADMIN_API_KEY=replace-with-32-plus-random-characters

# ── Administrator dashboard sign-in ──────────────────────
EVOTING_ADMIN_USERNAME=administrator
EVOTING_ADMIN_PASSWORD=replace-with-a-long-unique-password

# ── TLS ───────────────────────────────────────────────────
# Password for the PKCS12 keystore configured as server.ssl.key-store.
SERVER_SSL_KEYSTORE_PASSWORD=replace-with-keystore-password

# Set to false only for local HTTP development. A polling booth must never
# run with this off: ballots would travel unencrypted.
SESSION_COOKIE_SECURE=true
